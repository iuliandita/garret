#!/usr/bin/env python3
"""Generate a synthetic encrypted schema-18 phone archive through test-only code."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("output", type=Path, help="new local output directory; never commit its contents")
args = parser.parse_args()
out = args.output.resolve()
if out.exists():
    parser.error("output must not already exist")
out.parent.mkdir(parents=True, exist_ok=True)
repo = Path(__file__).resolve().parents[2]
with tempfile.TemporaryDirectory(prefix="garret-reader-fixture-") as temporary:
    env = os.environ.copy()
    env["CARGO_HOME"] = str(Path(env.get("CARGO_HOME", Path.home() / ".cargo")))
    env["RUSTUP_HOME"] = str(Path(env.get("RUSTUP_HOME", Path.home() / ".rustup")))
    for name in ("HOME", "XDG_DATA_HOME", "XDG_CONFIG_HOME", "XDG_CACHE_HOME", "TMPDIR"):
        target = Path(temporary) / name.lower()
        target.mkdir()
        env[name] = str(target)
    env["CARGO_BUILD_JOBS"] = "8"
    env["GARRET_READER_FIXTURE_OUT"] = str(out)
    subprocess.run(["nice", "-n", "10", "bun", "run", "build"], cwd=repo / "app/ui", env=env, check=True)
    shutil.copytree(repo / "app/ui/dist", repo / "app/shell-tauri/dist", dirs_exist_ok=True)
    subprocess.run(["nice", "-n", "10", "cargo", "test", "--locked", "--manifest-path",
                    str(repo / "app/shell-tauri/src-tauri/Cargo.toml"), "--bin", "garret",
                    "mobile_transfer::tests::write_schema18_phone_fixture", "--", "--ignored", "--exact"],
                   cwd=repo, env=env, check=True)
print(f"Archive, recovery key and instructions: {out}")
