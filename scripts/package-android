#!/usr/bin/env bash
set -euo pipefail
umask 077

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo=$(cd -- "$here/.." && pwd)
revision=$(git -C "$repo" rev-parse HEAD)
if [[ -n $(git -C "$repo" status --porcelain) ]]; then
  echo "commit or set aside working-tree changes before packaging" >&2
  exit 1
fi

cache="${XDG_CACHE_HOME:-$HOME/.cache}/garret-android-build"
keys="${ANDROID_SIGNING_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/garret/android-signing}"
if [[ ${CI:-} == true && ${ANDROID_ALLOW_NEW_KEY:-0} != 1 ]]; then
  [[ -s "$keys/preview.jks" && -s "$keys/password" ]] || {
    echo "release signing key/password missing; refusing to generate a replacement" >&2
    exit 1
  }
fi
out="$repo/app/dist-android/$revision"
mkdir -p "$cache/cargo" "$cache/builder" "$keys" "$out"
chmod 700 "$keys"
if [[ ! -f "$keys/password" ]]; then
  [[ ! -e "$keys/preview.jks" ]] || { echo "signing password is missing" >&2; exit 1; }
  python3 -c 'from pathlib import Path; import secrets, sys; Path(sys.argv[1]).write_text(secrets.token_hex(32))' "$keys/password"
fi
export APK_SIGNING_PASSWORD
APK_SIGNING_PASSWORD=$(cat "$keys/password")

cpus=$(getconf _NPROCESSORS_ONLN)
if (( cpus > 8 )); then cpus=8; fi
container=(docker run --rm --cpus "$cpus" --user "$(id -u):$(id -g)"
  --mount "type=bind,src=$repo,dst=/src"
  --mount "type=bind,src=$cache/cargo,dst=/cargo"
  --mount "type=bind,src=$cache/builder,dst=/home/builder"
  --env HOME=/home/builder --env CARGO_HOME=/cargo --env "CARGO_BUILD_JOBS=$cpus"
  --env "JAVA_TOOL_OPTIONS=-XX:ActiveProcessorCount=$cpus -Duser.home=/home/builder"
  --workdir /src/app/shell-tauri)
# Untracked local notes stay out of the build container.
if [[ -d "$repo/docs/local" ]]; then
  container+=(--mount "type=tmpfs,dst=/src/docs/local,tmpfs-mode=0700")
fi

(cd "$repo/app/mobile-ui" && bun run build)
"${container[@]}" garret-android tauri android init --ci --skip-targets-install
python3 "$here/android/prepare.py"
"${container[@]}" garret-android nice -n 10 tauri android build --ci --apk --target aarch64 x86_64 -- --locked

if [[ $(git -C "$repo" rev-parse HEAD) != "$revision" || -n $(git -C "$repo" status --porcelain) ]]; then
  echo "source changed during the build; refusing to label this package" >&2
  git -C "$repo" status --short >&2
  git -C "$repo" diff --stat >&2
  exit 1
fi
unsigned=$(python3 - "$repo" <<'PY'
from pathlib import Path
import sys
root = Path(sys.argv[1]) / "app/shell-tauri/src-tauri/gen/android/app/build/outputs/apk"
apks = list(root.glob("**/*release-unsigned.apk"))
if len(apks) != 1:
    raise SystemExit(f"expected one unsigned release APK, found {len(apks)}")
print(apks[0])
PY
)
cp "$unsigned" "$out/unsigned.apk"
"${container[@]}" --mount "type=bind,src=$keys,dst=/signing" --env APK_SIGNING_PASSWORD garret-android sh -eu -c '
  if [ ! -f /signing/preview.jks ]; then
    keytool -genkeypair -keystore /signing/preview.jks \
      -storepass:env APK_SIGNING_PASSWORD -keypass:env APK_SIGNING_PASSWORD \
      -alias preview -keyalg RSA -keysize 3072 -validity 3650 -dname "CN=garret preview"
  fi
  tools=/opt/android-sdk/build-tools/36.0.0
  "$tools/zipalign" -P 16 -f 4 "$1/unsigned.apk" "$1/aligned.apk"
  "$tools/apksigner" sign --ks /signing/preview.jks \
    --ks-pass env:APK_SIGNING_PASSWORD --key-pass env:APK_SIGNING_PASSWORD \
    --out "$1/garret-android.apk" "$1/aligned.apk"
  "$tools/apksigner" verify --verbose "$1/garret-android.apk"
  "$tools/zipalign" -c -P 16 4 "$1/garret-android.apk"
' sh "/src/app/dist-android/$revision"
unset APK_SIGNING_PASSWORD
{
  printf 'Source revision: %s\n' "$revision"
  printf 'Application version: %s\n' "$(python3 "$here/release.py" check)"
  printf 'Architectures: Android arm64-v8a and x86_64\n'
  printf 'Minimum Android API: 24\n'
  printf 'Built UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'Distribution: preview build, locally signed; not published to an app store\n'
  printf 'Runtime behavior: see separate verification receipt\n'
} > "$out/BUILD.txt"
(cd "$out" && sha256sum garret-android.apk > SHA256SUMS.txt)
cp "$here/android/README.md" "$out/README.md"
cp "$repo/COPYING" "$repo/THIRD-PARTY-NOTICES.md" "$out/"
printf 'APK: %s\n' "$out/garret-android.apk"
